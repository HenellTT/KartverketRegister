@{
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<link rel="stylesheet" href="~/css/SuperAdmin.css" />
<link rel="stylesheet" href="~/css/SuperAdminAssign.css" />

<script src="~/js/SuperAdminReviewAssign.js"></script>

<h1>Assign task to employee</h1>

<div id="SubmissionsContainer">
	<div class="AssignOptionMenu">Assign to selected submissions to: 
		<select id="SARA-SELECT"></select>
		<button onclick="SARA.PostBulkAssign()">Assign</button>
		<button onclick="SARA.AutoAssign()">Auto Assign</button>
		<button onclick="fetch('/Superadmin/UnAssignAll', {method:'POST', headers:{'X-CSRF-TOKEN':csrfToken}}).then(()=>location.reload())">Unassign all</button>
	</div>
	<div id="SARA-OUTPUT"></div>
</div>

<script>
	const csrfToken = '@Antiforgery.GetAndStoreTokens(Context).RequestToken';
	let SARA = new SuperAdminReviewAssign(csrfToken);
	SARA.Init();
</script>
